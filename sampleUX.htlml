<script>
const screens = [
  ['login','Login'],
  ['emp-inward','Employee: Inward'],
  ['emp-outward','Employee: Outward'],
  ['ship-out-modal','↳ Ship Out modal'],
  ['view-shipments-modal','↳ View Shipments modal'],
  ['admin-records','Admin: All Records'],
  ['admin-reports','Admin: Reports'],
  ['admin-lookups','Admin: Lookups'],
  ['admin-users','Admin: Users'],
  ['admin-company','Admin: Company Info'],
  ['admin-housekeeping','Admin: Housekeeping'],
  ['admin-backups','Admin: Backups'],
  ['root-login','★ Master: Root Login'],
  ['root-outward-all','★ Master: Root Outward (All)'],
  ['root-edit-from-all','★ Master: Edit works despite "All"'],
  ['root-companies','★ Master: Companies tab'],
  ['root-myaccount','★ Master: My Account (Root)'],
];
const nav = document.getElementById('nav');
nav.innerHTML = '<b>Pages</b>' + screens.map(([id,label])=>`<button data-target="${id}">${label}</button>`).join('');
function show(id){
  document.querySelectorAll('.screen').forEach(s=>s.classList.toggle('active', s.dataset.screen===id));
  document.querySelectorAll('#nav button[data-target]').forEach(b=>b.classList.toggle('active', b.dataset.target===id));
  window.scrollTo(0,0);
}
nav.querySelectorAll('button[data-target]').forEach(b=>b.addEventListener('click',()=>show(b.dataset.target)));
show('emp-inward');
</script>
</body>
</html>
