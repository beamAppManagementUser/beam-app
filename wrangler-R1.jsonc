{
  "name": "app",
  "main": "server.js",
  "compatibility_date": "2026-07-31",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "beam-app-db",
      "database_id": "YOUR_D1_DATABASE_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKETS",
      "bucket_name": "beam-app-uploads"
    }
  ],
  "vars": {
    "EMAIL_FROM_NAME": "Beam Veda"
  },
  "triggers": {
    "crons": ["0 2 * * 0", "0 3 * * 0", "0 4 * * *"]
  }
}
